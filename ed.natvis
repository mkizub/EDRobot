<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <Type Name="js::impl::key">
    <Intrinsic Name="isShort" Expression="s.sz &lt; 14" />
    <DisplayString Condition="isShort()">{s.buf}</DisplayString>
    <DisplayString                      >{l.ptr}</DisplayString>
    <Expand>
      <Item Condition="isShort()" Name="s.sz">s.sz</Item>
      <Item Condition="isShort()" Name="s.buf">s.buf</Item>
      <Item Condition="isShort()" Name="s.idx">s.idx</Item>
      <Item Condition="!isShort()" Name="l.sz">l.sz</Item>
      <Item Condition="!isShort()" Name="l.ptr">l.ptr</Item>
      <Item Condition="!isShort()" Name="l.idx">l.idx</Item>
    </Expand>
  </Type>

  <Type Name="js::impl::str">
    <Intrinsic Name="isShort" Expression="s.sz &lt; sizeof(s.buf)" />
    <DisplayString Condition="isShort()"   >{s.buf}</DisplayString>
    <DisplayString Condition="s.sz == 127" >shr {l.ptr}</DisplayString>
    <DisplayString                         >own {l.ptr}</DisplayString>
    <Expand>
      <Item Condition="isShort()" Name="s.sz">s.sz</Item>
      <Item Condition="isShort()" Name="s.buf">s.buf</Item>
      <Item Condition="!isShort()" Name="l.sz">l.sz</Item>
      <Item Condition="!isShort()" Name="l.ptr">l.ptr</Item>
    </Expand>
  </Type>

  <Type Name="ed::small_map&lt;*,*&gt;">
    <DisplayString Condition="size_ == 0 &amp;&amp; capacity_ == 0">empty</DisplayString>
    <DisplayString Condition="size_ == 0">size={size_} ({capacity_})</DisplayString>
    <DisplayString>size={size_} ({capacity_}) [ {*data_}, ... ]</DisplayString>
    <Expand>
      <Item Name="size">size_</Item>
      <Item Name="capacity">capacity_</Item>
      <ArrayItems>
        <Size>size_</Size>
        <ValuePointer>data_</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="js::value::arr_val">
    <DisplayString Condition="arr.m_size == 0">[]</DisplayString>
    <DisplayString Condition="arr.m_size == 1">[{*arr.m_data}]</DisplayString>
    <DisplayString Condition="arr.m_size == 2">[{arr.m_data[0]}, {arr.m_data[1]}]</DisplayString>
    <DisplayString Condition="arr.m_size == 3">[{arr.m_data[0]}, {arr.m_data[1]}, {arr.m_data[2]}]</DisplayString>
    <DisplayString                            >[{arr.m_data[0]}, {arr.m_data[1]}, {arr.m_data[2]}, ...] size={arr.m_size}</DisplayString>
    <Expand>
      <Item Name="size">arr.m_size</Item>
      <Item Name="capacity">arr.m_capacity</Item>
      <ArrayItems>
        <Size>arr.m_size</Size>
        <ValuePointer>arr.m_data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="js::value::obj_val">
    <DisplayString                             >{map}</DisplayString>
    <Expand>
      <ExpandedItem>map</ExpandedItem>
    </Expand>
  </Type>

  <Type Name="js::value">
    <DisplayString Condition="content._Which == 0">null</DisplayString>
    <DisplayString Condition="content._Which == '\x1'">{*(bool*)&amp;content}</DisplayString>
    <DisplayString Condition="content._Which == '\x2'">{*(__int64*)&amp;content}</DisplayString>
    <DisplayString Condition="content._Which == '\x3'">{*(double*)&amp;content}</DisplayString>
    <DisplayString Condition="content._Which == '\x4'">{*(js::impl::str*)&amp;content}</DisplayString>
    <DisplayString Condition="content._Which == '\x5'">{*(js::value::arr_val*)&amp;content}</DisplayString>
    <DisplayString Condition="content._Which == '\x6'">{*(js::value::obj_val*)&amp;content}</DisplayString>
    <DisplayString>{content}</DisplayString>
    <Expand>
      <ExpandedItem>content</ExpandedItem>
    </Expand>
  </Type>

</AutoVisualizer>