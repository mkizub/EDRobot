    PUSHBUTTON      "Save",ID_SAVE,88,157,31,14
END

IDD_ED_ROBOT DIALOGEX 0, 0, 201, 245
STYLE DS_ABSALIGN | DS_SETFONT | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "EDRobot"
