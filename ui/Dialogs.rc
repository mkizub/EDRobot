    LTEXT           "Task:",IDC_STATIC,15,16,30,8
    CTEXT           "Task Name",IDC_CURRENT_TASK,49,15,138,11,WS_BORDER
    PUSHBUTTON      "Watch",IDC_BUTTON_WATCH,75,223,50,14,BS_CENTER
    PUSHBUTTON      "Stop",IDC_BUTTON_STOP_NEW,72,30,50,14,BS_CENTER
    PUSHBUTTON      "Pause",IDC_BUTTON_PAUSE_RESUME,137,30,50,14,BS_CENTER
    LTEXT           "Task Status",IDC_TASK_STATUS,7,48,187,158,WS_BORDER
    LTEXT           "Status",IDC_STATUS,7,210,187,8
    CONTROL         "Top",IDC_KEEP_ON_TOP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,31,54,10
END

