IDD_ABOUTBOX DIALOGEX 0, 0, 222, 89
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ED Robot"
FONT 10, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_DIALOGS,IDC_STATIC,14,14,20,20
    LTEXT           "Press 'Print Screen' key to start selling\nPress 'Esc' to stop",IDC_STATIC_1,42,14,173,54,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,165,68,50,14,WS_GROUP
    CONTROL         "Version: 1.0.0",IDC_VERSION,"Static",SS_SIMPLE | SS_NOTIFY | WS_GROUP,21,72,111,9
END

IDD_ADD_TASK DIALOGEX 0, 0, 209, 178
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "EDRobot Add Task"
FONT 10, "Microsoft Sans Serif", 400, 0, 0xCC
BEGIN
    DEFPUSHBUTTON   "Run",ID_RUN,27,157,31,14
    PUSHBUTTON      "Delete",ID_DELETE,149,157,31,14
