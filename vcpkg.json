{
  "name" : "edrobot",
  "version-string" : "1.0.0",
  "builtin-baseline" : "9eb6e4b60ea5bdd60a87e8d2353d53882a32a3f3",
  "configuration" : {
    "overlay-ports" : [ "./overlay-ports/opencl", "./overlay-ports/opencv4" ]
  },
  "dependencies" : [ {
    "name" : "cpptrace",
    "version>=" : "1.0.0"
  }, {
    "name" : "opencl",
    "version>=" : "2024.10.24#2",
    "default-features" : false
  }, {
    "name" : "opencv4",
    "version>=" : "4.13.0",
    "features" : [ "win32ui", "highgui", "dnn", "opencl", "intrinsics", "thread", "jpeg", "png", "ipp", "fs", "world" ],
    "default-features" : false
  }, {
    "name" : "gettext",
    "version>=" : "0.22.5",
    "default-features" : false
  }, {
    "name" : "tesseract",
    "version>=" : "5.5.1",
    "default-features" : false
  }, {
    "name" : "winlamb",
    "version>=" : "2020-10-15"
  }, {
    "name" : "curl",
    "version>=" : "8.14.1"
  }, {
    "name" : "boost-circular-buffer",
    "version>=" : "1.90.0"
  }, {
    "name" : "zlib",
    "version>=" : "1.3.1"
  }, {
    "name" : "cpr",
    "version>=" : "1.14.2"
  }, {
    "name" : "spdlog",
    "version>=" : "1.17.0",
    "features" : [ "wchar" ],
    "default-features" : false
  }, {
    "name" : "openssl"
  }, {
    "name" : "sqlite3",
    "version>=" : "3.52.0",
    "features" : [ "json1", "math", "rtree" ]
  } ]
}