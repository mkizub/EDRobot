{
  "default-key-hold-time": 35,
  "default-key-after-time": 65,
  "search-region-extent": 10,
  "tesseract-data-path": "tessdata-fast", // defaults to "tessdata-fast"
  "capturer-WinRT-disabled": true,
  "capturer-Win32-disabled": false,
  "capturer-DXGI-disabled": false,
  "opencl-disabled": false,
  "auto-pause": false, // default is true
  shortcuts: {
    start: "PrintScreen", // defaults to "printscreen"
    stop: "Esc", // defaults to "esc"
    //pause: "Pause", // not used
    resume: "ScrollLock", // defaults to "scrolllock"
    "debug-templates": "Ctrl+Alt+PrintScreen", // defaults to "ctrl+alt+printscreen"
    //shutdown: "...", // no default, can exit from 'start trade' dialog
  }
}
