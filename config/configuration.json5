{
  "default-key-hold-time": 35,
  "default-key-after-time": 65,
  "search-region-extent": 10,
  "tesseract-data-path": "tessdata", // defaults to "tessdata"
  "capturer-DXGI-disabled": false, // preferred if full-screen/borderless mode
  "capturer-WinRT-disabled": false, // preferred if windowed mode
  "capturer-Win32-disabled": false, // fallback if DXGI/WinRT fail or disabled
  "opencl-disabled": false,
  "opencl-cache-dir": "cache", // use "disabled" to disable opencl cache
  "vjoy-device-id": 1,
  "auto-pause": false, // default is true
  shortcuts: {
    start: "PrintScreen", // defaults to "printscreen"
    stop: ["Esc","Ctrl+Break"], // defaults to "esc" and ctrl-break
    "pause-resume": "Pause",
    "debug-templates": "Ctrl+Alt+PrintScreen", // defaults to "ctrl+alt+printscreen"
  }
}
